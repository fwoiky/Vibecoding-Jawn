# Copy this file to ".env" (same folder as jarvis.py) and fill in what you need.
# .env is git-ignored. Never commit real keys.

# ---- AI (required for answers) ---------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible server (e.g. a local one). Leave empty for OpenAI.
OPENAI_BASE_URL=

# ---- Voice (optional) ------------------------------------------------------------------
# Only needed if you set JARVIS_TTS_PROVIDER=elevenlabs. Key from https://elevenlabs.io (Profile -> API keys)
ELEVENLABS_API_KEY=

# ---- Optional overrides (every setting in the Settings dialog can also be set here) ------
# JARVIS_TTS_PROVIDER=edge            # edge | elevenlabs | piper
# JARVIS_EDGE_VOICE=en-GB-RyanNeural
# JARVIS_OPENAI_MODEL=gpt-4o-mini
# JARVIS_WHISPER_MODEL=small.en       # GPU model; try medium.en for more accuracy
# JARVIS_CAMERA_SOURCE=0              # webcam index, or a video file path for testing
# JARVIS_GREETING_COOLDOWN_MIN=30
# JARVIS_UNKNOWN_GREETING=none        # none | neutral
# JARVIS_AUTOSTART=0                  # 1 = start camera/mic immediately on launch (default: wait for START)
